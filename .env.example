# Primary target model (Gemini). Required only for LIVE-model runs.
# Without it, the harness runs the deterministic surrogate agent (offline mode).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Live-run pacing. The Gemini FREE tier allows 5 requests/min/model, and a sweep
# that dies half way measured nothing -- so requests are throttled and 429s retried.
# Set MD_GEMINI_RPM=0 on a paid key to remove the throttle entirely.
MD_GEMINI_RPM=5
# The decision is one choice over enumerated options; reasoning tokens buy nothing
# but latency. Set to 1 to re-enable Gemini thinking.
MD_GEMINI_THINKING=0

# Alternate model for transfer tests (R(delta)). Optional.
# BASE_URL is any OpenAI-compatible /chat/completions host. Leave unset for OpenAI.
#   Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
# NOTE: pointing this at Gemini gives cross-MODEL transfer, not cross-VENDOR --
# the report derives that from the endpoint host, so it cannot be overclaimed.
ALT_MODEL_API_KEY=
ALT_MODEL_NAME=
ALT_MODEL_BASE_URL=

# Third, held-out model. Never used by fitness; eval only. Optional.
HELDOUT_MODEL_API_KEY=
HELDOUT_MODEL_NAME=
HELDOUT_MODEL_BASE_URL=

# Objective thresholds (see src/minimal_drift/config.py for defaults)
MD_TAU=0.30
MD_RHO=0.50
MD_N_SEEDS=12
MD_SEED=1337

# Signing mode for the mandate chain: hmac-mock (default) or es256 (real ECDSA).
# MD_SIGN_MODE=es256

# The unit suite is hermetic: it pops the API keys so tests never call a metered
# endpoint. Set to 1 only when you deliberately want the live path under test.
# MD_TEST_LIVE=1
